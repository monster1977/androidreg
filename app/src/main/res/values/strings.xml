    <string name="settings_ring_30">Последние 30 минут</string>
    <string name="settings_ring_60">Последний 1 час</string>
    <string name="settings_ring_120">Последние 2 часа</string>
    <string name="settings_timestamp">Дата и время на видео</string>
    <string name="settings_timestamp_desc">Метка вжигается в кадр, поэтому останется и в сохранённом файле.</string>
    <string name="settings_auto_bright">Автояркость в сумерках</string>
    <string name="settings_auto_bright_desc">Камера сама повышает экспозицию, когда кадр становится тёмным — вечернее видео будет светлее.</string>
    <string name="settings_gps">GPS-координаты и скорость</string>
    <string name="settings_gps_desc">Показываются на кадре вместе с меткой времени. Нужно разрешение на геолокацию.</string>
    <string name="settings_charge">Автозапись при подключении зарядки</string>
    <string name="settings_charge_desc">Запись начнётся, как только телефон подключится к питанию.</string>
    <string name="settings_unlock">Открывать при разблокировке</string>
    <string name="settings_unlock_desc">После разблокировки телефона приложение откроется само. Для этого в фоне работает служба с постоянным уведомлением. Android разрешает открывать приложение из фона только с доступом «Поверх других приложений»; без него придёт уведомление.</string>
    <string name="unlock_overlay_title">Нужен доступ «Поверх других приложений»</string>
    <string name="unlock_overlay_message">Android не даёт приложениям открываться из фона без этого разрешения. Разрешите доступ в системных настройках — и регистратор будет открываться сам после разблокировки.</string>
    <string name="unlock_overlay_grant">Разрешить</string>
    <string name="unlock_overlay_unavailable">Не удалось открыть настройки разрешения</string>
    <string name="settings_vendor_autostart">Системный автозапуск</string>
    <string name="settings_vendor_autostart_desc">На некоторых прошивках (Blackview, Xiaomi, Huawei и других) есть отдельный список приложений, которым разрешён автозапуск. Если приложение не открывается после перезагрузки, включите его в этом списке.</string>
    <string name="vendor_autostart_unavailable">Не удалось открыть системные настройки автозапуска</string>

    <string name="settings_stationary">Останавливать запись при стоянке</string>
    <string name="settings_stationary_desc">Если координаты не меняются выбранное время, запись останавливается, а экран блокируется. Нужны геолокация и разрешение администратора устройства.</string>
    <string name="settings_stationary_timeout">Нет движения дольше</string>
    <string name="settings_lock_admin">Разрешить блокировку экрана</string>
    <string name="settings_lock_admin_on">Блокировка экрана включена</string>
    <string name="settings_lock_admin_desc">Android блокирует экран только с правами администратора устройства. Нажмите кнопку и подтвердите — это нужно один раз.</string>
    <string name="device_admin_label">Блокировка экрана Dashcam</string>
    <string name="device_admin_desc">Приложение сможет блокировать экран после остановки записи на стоянке.</string>
    <string name="stationary_lock_unavailable">Запись остановлена, но экран не заблокирован: разрешите в Настройках</string>
    <string name="lock_admin_unavailable">Не удалось открыть настройки администратора устройства</string>

    <string name="settings_palm">Приложение по жесту «ладонь»</string>
    <string name="settings_palm_desc">Пока запись остановлена, открытая ладонь откроет выбранное приложение. Если выбран 2ГИС — жест попросит адрес и сразу включит навигацию. «Не выбрано» — жест ничего не делает.</string>
    <string name="settings_palm_none">Не выбрано</string>
    <string name="settings_palm_pick">Приложение для жеста «ладонь»</string>

    <string name="settings_two_gis_key">Ключ 2ГИС Geocoder</string>
    <string name="settings_two_gis_key_desc">Нужен для голосового ввода адреса. Ключ бесплатный: dev.2gis.com → проект → Geocoder API.</string>
    <string name="two_gis_key_empty">Ключ не задан</string>
    <string name="two_gis_key_set">Ключ задан</string>
    <string name="two_gis_key_title">Ключ 2ГИС Geocoder</string>
    <string name="two_gis_key_help">Вставьте ключ Geocoder API из личного кабинета dev.2gis.com. Ключ хранится только в настройках приложения.</string>
    <string name="two_gis_key_hint">например, 01234567-89ab-cdef-0123-456789abcdef</string>

