<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Экран: кадр с камеры, бургер, таймер и быстрая кнопка записи -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Дежурный режим: пока запись остановлена, здесь фронтальная камера -->
        <androidx.camera.view.PreviewView
            android:id="@+id/gesturePreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/buttonMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="@string/action_menu"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/textTimer"
            style="@style/Theme.Dashcam.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:text="@string/timer_idle"
            android:textStyle="bold" />

        <!-- Метка времени поверх кадра: показывается, только если её не удалось вжечь в видео -->
        <TextView
            android:id="@+id/textTimestamp"
            style="@style/Theme.Dashcam.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="72dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Подсказка дежурного режима: пока запись не идёт, ждём жест «V» -->
        <LinearLayout
            android:id="@+id/gesturePanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="92dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textGestureHint"
                style="@style/Theme.Dashcam.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gesture_wait_hint" />

            <TextView
                android:id="@+id/textGestureNow"
                style="@style/Theme.Dashcam.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonRecord"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_record_button"
            android:backgroundTint="@color/record_idle"
            android:contentDescription="@string/action_record"
            android:scaleType="centerInside"
            android:src="@drawable/ic_record"
            app:tint="@color/white" />
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_main"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:itemVerticalPadding="4dp"
        app:menu="@menu/main_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
